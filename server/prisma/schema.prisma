generator client {
  provider      = "prisma-client-js"
  // node:22-slim (Debian bookworm) has no `openssl` CLI, so Prisma can't
  // probe the actual libssl version - not just at `prisma generate` time,
  // but also in the running container's own engine-selection logic, which
  // also silently mis-detects "native" as openssl-1.1.x (a library the
  // image doesn't have; it ships openssl 3.0 only) even when the correct
  // engine is also bundled alongside it. Deliberately NOT listing "native"
  // here - it's the wrong engine in this specific base image, and its
  // presence gets picked over the correct one at runtime.
  binaryTargets = ["debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Core / Auth ----------

enum UserRole {
  CUSTOMER
  VENDOR
  RESTAURANT_OWNER
  RIDER
  DELIVERY_AGENT
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  // Nullable: every customer-facing account is phone+OTP (see auth.routes.js)
  // and always has one, but an ADMIN created via email+password (the admin
  // console's own login, separate from the customer OTP flow) never gets a
  // phone assigned - Postgres allows multiple NULLs under a UNIQUE index, so
  // this doesn't weaken the phone uniqueness guarantee for real accounts.
  phone        String?  @unique
  name         String?
  email        String?  @unique
  // Only ever set for ADMIN accounts that log in via POST /auth/admin/login
  // (bcrypt hash - see utils/password.js). OTP-authenticated accounts never
  // have one, and this alone is not enough to log in as non-ADMIN - see
  // adminLogin's role check in auth.controller.js.
  passwordHash String?
  avatarUrl    String?
  role         UserRole @default(CUSTOMER)
  // Admin suspend/ban switch (see PATCH /api/admin/users/:id) - requireAuth
  // rejects any request from an inactive user with 403, independent of
  // whether their token is still otherwise valid.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses             Address[]
  cartItems             CartItem[]
  orders                Order[]
  wishlist              Wishlist[]
  reviews               Review[]
  deliveryRequests      DeliveryRequest[]     @relation("DeliveryRequester")
  insurancePolicies     InsurancePolicy[]
  insuranceAutoPolicies InsuranceAutoPolicy[]
  rideRequests          RideRequest[]         @relation("RideRequester")
  restaurantOrders      RestaurantOrder[]
  mobileTransactions    MobileTransaction[]
  payments              Payment[]
  wallet                Wallet?
  // Opt-in gig work / selling: any user can self-serve into role
  // DELIVERY_AGENT, RIDER, or VENDOR (see PATCH /api/auth/role). role isn't
  // checked anywhere else in the app, so this doesn't affect their ability
  // to keep shopping/ordering as a customer too.
  assignedDeliveries    DeliveryRequest[]     @relation("DeliveryAgent")
  assignedRides         RideRequest[]         @relation("AssignedRider")
  store                 Store?                @relation("StoreOwner")
  restaurant            Restaurant?           @relation("RestaurantOwner")
  // Anando (peer-to-peer carpooling) - any user can post a ride they're
  // already making (as driver) and/or book a seat on someone else's (as
  // passenger); this is independent of the RIDER gig-work role above.
  ridePostings          RidePosting[]         @relation("RidePostingDriver")
  rideBookings          RideBooking[]         @relation("RideBookingPassenger")
  notifications         Notification[]
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  line1     String
  city      String
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ---------- Ecommerce module ----------

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  icon     String?
  parentId String?
  // Admin takedown switch (see AdminCategoriesTab.js) - hides the category
  // from public browsing/the vendor product-form dropdown without deleting
  // it, since existing Product rows reference it by id. Any vendor can
  // also create a category (POST /vendor/categories, always active) - this
  // is the only way to deactivate one, deliberately admin-only.
  isActive Boolean    @default(true)
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")
  products Product[]
}

model Store {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  logoUrl  String?
  address  String?
  lat      Float?
  lng      Float?
  rating   Float     @default(0)
  // Admin suspension switch (see AdminVendorsTab.js): suspended stores'
  // products drop out of every public product listing and the storefront
  // shows an "unavailable" state, without deleting the vendor's data.
  isActive Boolean   @default(true)
  // Nullable + unique: null for admin/seed-managed stores (no self-service
  // owner), unique among non-null values so a vendor can own at most one
  // store (Postgres unique constraints allow any number of NULLs).
  ownerId  String?   @unique
  products Product[]

  owner User? @relation("StoreOwner", fields: [ownerId], references: [id])
}

model Product {
  id              String   @id @default(uuid())
  storeId         String
  categoryId      String
  name            String
  slug            String   @unique
  description     String?
  images          String[]
  price           Decimal  @db.Decimal(10, 2)
  discountPrice   Decimal? @db.Decimal(10, 2)
  discountPercent Int?
  stock           Int      @default(0)
  rating          Float    @default(0)
  tags            String[]
  // Soft-delete flag so a vendor "removing" a product doesn't break FK
  // references from existing CartItem/OrderItem/Wishlist/Review rows.
  // Public listing/detail endpoints filter this out; the vendor's own
  // product list does not.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  store      Store       @relation(fields: [storeId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlist   Wishlist[]
  reviews    Review[]

  @@index([categoryId])
  @@index([storeId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  deliveryAddressId String?
  status            OrderStatus @default(PENDING)
  // subtotal is the sum of line items only, and is what vendor payout
  // (payoutVendorsForOrder) is computed from - it never changes shape
  // regardless of fee/tax config. total is what's actually charged
  // (subtotal + feeAmount + taxAmount), computed from admin-configured
  // ServiceFeeConfig rows per vendor Store - see createOrder in
  // ecommerce/orders.controller.js. feeAmount/taxAmount default to 0 so
  // existing rows (backfilled subtotal = total) read as "no fee configured".
  subtotal          Decimal     @db.Decimal(10, 2)
  feeAmount         Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  // Payment is tracked separately from fulfillment status above - `paid`
  // only flips true once the PayDunya IPN webhook confirms the invoice,
  // never optimistically on order creation.
  paid              Boolean     @default(false)
  paymentId         String?     @unique
  createdAt         DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id])
  deliveryAddress Address?    @relation(fields: [deliveryAddressId], references: [id])
  payment         Payment?    @relation(fields: [paymentId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---------- Delivery module (stub) ----------

enum DeliveryStatus {
  REQUESTED
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

model DeliveryRequest {
  id              String         @id @default(uuid())
  userId          String
  // Contact details for whoever's handing off / receiving the package -
  // may differ from the requesting account (e.g. sending a package on
  // someone else's behalf). Nullable: falls back to the requester's own
  // User.name/phone at read time (see delivery.controller.js) rather than
  // duplicating them here when the requester is also the sender.
  senderName      String?
  senderPhone     String?
  pickupAddress   String
  pickupLat       Float?
  pickupLng       Float?
  receiverName    String?
  receiverPhone   String?
  dropoffAddress  String
  dropoffLat      Float?
  dropoffLng      Float?
  packageNote     String?
  priceEstimate   Decimal?       @db.Decimal(10, 2)
  // Distance used to compute priceEstimate (road distance via Google's
  // Distance Matrix API when configured, else Haversine - see
  // server/src/utils/distanceMatrix.js). Null when priceEstimate fell back
  // to the no-coordinates flat-ish random estimate.
  distanceKm      Float?
  status          DeliveryStatus @default(REQUESTED)
  assignedAgentId String?
  // Agent's last-reported GPS position while this job is ACCEPTED/PICKED_UP
  // (see PATCH /delivery/jobs/:id/location) - powers the customer-facing
  // live tracking map. Stays at its last value after DELIVERED rather than
  // being cleared, as a cheap "where did it end up" record.
  agentLat        Float?
  agentLng        Float?
  agentLocationAt DateTime?
  createdAt       DateTime       @default(now())

  user            User             @relation("DeliveryRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignedAgent   User?            @relation("DeliveryAgent", fields: [assignedAgentId], references: [id])
  // Back-relation for RestaurantOrder.deliveryRequestId - lets a dispatched
  // restaurant order's DeliveryRequest be traced back to it (see
  // markDelivered's status cascade in delivery.controller.js).
  restaurantOrder RestaurantOrder?

  @@index([assignedAgentId])
}

// ---------- Insurance module (stub) ----------

enum InsuranceCategory {
  HEALTH
  AUTO
  HOME
  TRAVEL
  LIFE
}

model InsurancePlan {
  id             String            @id @default(uuid())
  name           String
  category       InsuranceCategory
  provider       String
  premiumMonthly Decimal           @db.Decimal(10, 2)
  coverageAmount Decimal           @db.Decimal(12, 2)
  description    String?

  policies InsurancePolicy[]
}

enum PolicyStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
}

model InsurancePolicy {
  id        String       @id @default(uuid())
  userId    String
  planId    String
  status    PolicyStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan InsurancePlan @relation(fields: [planId], references: [id])
}

// Auto insurance bought through a real external integrator (A.A.S "Assurance
// Digitale" - see server/src/modules/insurance/aas.controller.js and
// server/docs/aas-integration.md), not the static InsurancePlan catalog
// above. Deliberately a separate model: the lifecycle (quote -> pay ->
// issue-with-a-real-underwriter, which can fail after payment) and the
// fields it needs (vehicle identifiers, guarantee codes, a partner
// reference AAS enforces uniqueness on, the issued attestation link) don't
// fit the flat "subscribe to a static plan" shape InsurancePolicy has.
enum InsuranceAutoStatus {
  PENDING // quote accepted, not yet paid
  ISSUING // wallet debited, AAS issuance call in flight or just failed before we could record why
  ACTIVE // AAS returned a real attestation link - the only way this status is ever set
  FAILED // AAS could not price/issue; wallet refunded if it had been debited
  CANCELLED // a previously ACTIVE policy was cancelled (qrcode.mono.cancel)
}

model InsuranceAutoPolicy {
  id          String @id @default(uuid())
  userId      String
  // Kept as a plain string, not a relation, so a second real integrator
  // slots in later without a schema change - the comparison engine already
  // shapes quotes as { companyCode, tier, premium, ... } for exactly this.
  companyCode String @default("AAS")
  // Key into AAS_TIER_GARANTIES/AAS_MOTO_TIER_GARANTIES (see
  // server/src/constants/aasGuarantees.js) at the time of purchase - which
  // guarantee codes a tier actually buys can change over time, so the
  // codes actually purchased are captured below independently of this key.
  tier        String

  // Vehicle identifiers AAS's live API reads unconditionally (see the
  // integration notes: "optional" in the PDF means "may be empty", not
  // "may be omitted" - chassis/immatriculation are always sent, so they're
  // always known here too).
  genre               String
  energie             String
  immatriculation     String
  chassis             String
  // puissanceFiscale (mono, rc.request/qrcode.request) and cylindre (deux
  // roues, rc.moto/moto.request) are mutually exclusive per vehicleType -
  // both nullable since a given policy only ever uses one. Confirmed
  // fields from the PDF's section 5.1/5.2/6.1/6.2 request-param tables.
  puissanceFiscale    String?
  cylindre            Int?
  nombrePlace         Int
  dateMiseCirculation DateTime
  modele              String
  marque              String
  valeurNeuve         Decimal? @db.Decimal(12, 2)
  valeurActuelle      Decimal? @db.Decimal(12, 2)
  // "commerciale"/"non_commerciale" per section 3.3.6's metadata table vs.
  // "COMMERCIAL"/"NON_COMMERCIAL" per section 6.1's rc.moto request-param
  // table - the PDF disagrees with itself; aasClient.js sends the 6.1
  // spelling since that's the literal request-body spec. Deux roues only.
  usage               String?

  typePersonne String
  // {nom, prenom, cellulaire, email} each - confirmed shape from
  // qrcode.request/moto.request's souscripteur/assure Objet tables (PDF
  // section 5.2/6.2). Kept as JSON rather than 8 more flat columns since
  // nothing here needs to be queried/filtered on.
  souscripteur Json
  assure       Json

  // Guarantee codes 1-9 actually purchased (base RC/Responsabilité Civile
  // is implicit, always priced); garantiesOptPT is required by AAS's live
  // API whenever garanties contains code 2, else HTTP 400 - see
  // aasClient.js. Codes 4 (avance/recours) and the assistance option are
  // deliberately never populated - the integration notes flag both as
  // "not sold today" / needing AAS clarification first.
  garanties      Int[]
  garantiesOptPT String?

  periodicite String
  duree       Int

  // What the comparison screen quoted vs. what AAS actually charged at
  // issuance - "Never sell what cannot be issued" means these should
  // always match, but they're tracked separately so a mismatch is visible
  // rather than silently trusted.
  premiumEstimate Decimal  @db.Decimal(10, 2)
  premiumCharged  Decimal? @db.Decimal(10, 2)

  status InsuranceAutoStatus @default(PENDING)

  // AAS rejects a reused reference outright ("La reference doit être
  // unique"), including after a failed attempt - a retry must carry a
  // fresh one. This is the base value; retries append -R1, -R2 per
  // fulfillmentAttempts (see issueMonoPolicy in aas.controller.js).
  // Retrying is refused once linkAttestation is set, which is what stops
  // a second attestation being bought for one order.
  referenceTrxPartner String @unique
  fulfillmentAttempts Int    @default(0)

  // AAS's live issuance response has no attestationNumber field (despite
  // the PDF listing one) - only this link, which ends in the number.
  linkAttestation String?

  // Set on FAILED so "AAS refused the payload" and "we never sent the
  // field" stay distinguishable - see requestSnapshot/responseSnapshot.
  fulfillmentError     String?
  fulfillmentErrorCode String?
  // Full rating payload sent (incl. souscripteur/assure, not modeled as
  // their own columns since they're pass-through to AAS) and AAS's raw
  // response, for support/ops when a failure needs investigating.
  requestSnapshot      Json?
  responseSnapshot     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Restaurant module (stub) ----------

model Restaurant {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  logoUrl  String?
  cuisine  String?
  rating   Float   @default(0)
  address  String?
  lat      Float?
  lng      Float?
  // Admin suspension switch (see AdminRestaurantsTab.js) - same pattern as
  // Store.isActive: a suspended restaurant drops out of public browsing
  // and its page shows an "unavailable" state, without deleting the
  // owner's menu/order history.
  isActive Boolean @default(true)
  // Nullable + unique: null for admin/seed-managed restaurants (no self-
  // service owner), unique among non-null values so a restaurant owner
  // runs at most one restaurant (mirrors Store.ownerId).
  ownerId  String? @unique

  owner     User?             @relation("RestaurantOwner", fields: [ownerId], references: [id])
  menuItems MenuItem[]
  orders    RestaurantOrder[]
}

model MenuItem {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  price        Decimal @db.Decimal(10, 2)
  imageUrl     String?
  category     String?
  // Soft delete, mirrors Product.isActive - existing order line items
  // reference a menu item by id, so removing one from the menu flips
  // this off instead of deleting the row.
  isActive     Boolean @default(true)

  restaurant Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems RestaurantOrderItem[]
}

// A restaurant order is placed against a single restaurant in one go (no
// persistent server-side cart, unlike the ecommerce module) - the client
// builds the item list locally and submits it as one request.
model RestaurantOrder {
  id                String      @id @default(uuid())
  userId            String
  restaurantId      String
  status            OrderStatus @default(PENDING)
  // Same subtotal/fee/tax split as Order above - critically,
  // payoutOwnerForOrder (restaurant.service.js) is computed from
  // `subtotal`, not `total`, so the owner's share is never inflated by
  // the platform fee/TVA added on top for the customer.
  subtotal          Decimal     @db.Decimal(10, 2)
  feeAmount         Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  note              String?
  // Tracked separately from fulfillment status, same split as Order.paid -
  // only true once wallet payment settles at checkout (see
  // orders.controller.js's createOrder).
  paid              Boolean     @default(false)
  // Where this order gets delivered - required at checkout. This module
  // is delivery-only for now (no in-app "pickup at restaurant" option),
  // so every order needs a real dropoff to hand to the delivery module.
  deliveryAddress   String?
  deliveryLat       Float?
  deliveryLng       Float?
  // Set once the restaurant marks the order ready and a DeliveryRequest is
  // auto-created for it, so it travels through the same agent dispatch
  // board as any other package delivery (see dispatchForDelivery in
  // orders.controller.js). Nullable/unique: null until dispatched, at
  // most one DeliveryRequest per order.
  deliveryRequestId String?     @unique
  createdAt         DateTime    @default(now())

  user            User                  @relation(fields: [userId], references: [id])
  restaurant      Restaurant            @relation(fields: [restaurantId], references: [id])
  deliveryRequest DeliveryRequest?      @relation(fields: [deliveryRequestId], references: [id])
  items           RestaurantOrderItem[]
}

model RestaurantOrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal @db.Decimal(10, 2)

  order    RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem        @relation(fields: [menuItemId], references: [id])
}

// ---------- Ride sharing module (stub) ----------

enum VehicleType {
  MOTO
  ECONOMY
  COMFORT
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model RideRequest {
  id              String      @id @default(uuid())
  userId          String
  pickupAddress   String
  pickupLat       Float?
  pickupLng       Float?
  dropoffAddress  String
  dropoffLat      Float?
  dropoffLng      Float?
  vehicleType     VehicleType @default(ECONOMY)
  priceEstimate   Decimal?    @db.Decimal(10, 2)
  status          RideStatus  @default(REQUESTED)
  assignedRiderId String?
  createdAt       DateTime    @default(now())

  user          User  @relation("RideRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignedRider User? @relation("AssignedRider", fields: [assignedRiderId], references: [id])

  @@index([assignedRiderId])
}

// ---------- Mobile top-up / bill payment module ----------

enum MobileServiceType {
  AIRTIME
  DATA_BUNDLE
  BILL
}

enum BillCategory {
  ELECTRICITY
  WATER
  TV
  INTERNET
  OTHER
}

// Catalog of top-up operators and billers - managed from the backend
// (seeded here, editable via direct DB/admin access), not hardcoded in
// either client, per the request that "mobile services will be added from
// backend".
model MobileService {
  id            String            @id @default(uuid())
  name          String
  logoUrl       String?
  type          MobileServiceType
  billCategory  BillCategory?
  // Phone prefixes used to auto-detect the operator from a typed number in
  // the airtime flow (e.g. Orange CI: "07", "08", "09"). Empty for billers.
  phonePrefixes String[]          @default([])
  minAmount     Decimal?          @db.Decimal(10, 2)
  maxAmount     Decimal?          @db.Decimal(10, 2)
  isActive      Boolean           @default(true)

  transactions MobileTransaction[]
  forfaits     MobileForfait[]
}

// Named recharge bundles for an AIRTIME service (e.g. Expresso Sénégal's
// "Disso" voice packs and "Pronet jour/semaine/mois" data packs) - an
// alternative to typing an arbitrary top-up amount. `category` groups
// bundles into the operator's own named families (free text, not an enum,
// since every operator brands its bundles differently - mirrors Provider.
// category). callMinutesLabel/internetLabel/validityLabel are kept as the
// operator's own display strings (e.g. "20 mn Tous réseaux", "250Mo",
// "24H") rather than parsed into numeric minutes/MB/hours, since that
// parsing would invent a normalization (1000 vs 1024 for Go->Mo, "J" vs
// "H" units) the source catalog doesn't actually specify - `price` is the
// only field that needs to be a real number, since it's the only one the
// purchase flow computes with.
model MobileForfait {
  id               String   @id @default(uuid())
  serviceId        String
  category         String
  name             String
  price            Decimal  @db.Decimal(10, 2)
  callMinutesLabel String?
  internetLabel    String?
  validityLabel    String
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  service      MobileService       @relation(fields: [serviceId], references: [id])
  transactions MobileTransaction[]

  @@index([serviceId, isActive])
}

enum MobileTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model MobileTransaction {
  id            String                  @id @default(uuid())
  userId        String
  serviceId     String
  // Set only when this top-up was a forfait purchase rather than an
  // arbitrary amount - see createTopup in mobile.controller.js.
  forfaitId     String?
  type          MobileServiceType
  phoneNumber   String?
  accountNumber String?
  // amount is unchanged in meaning (the forfait's price, or the amount the
  // customer typed) - feeAmount/taxAmount are charged on top of it, from
  // admin-configured ServiceFeeConfig, and default to 0 for the common
  // case of no fee configured. See createTopup/createBillPayment.
  amount        Decimal                 @db.Decimal(10, 2)
  feeAmount     Decimal                 @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal                 @default(0) @db.Decimal(10, 2)
  // Created PENDING, flipped to SUCCESS once the wallet debit clears (or
  // the row is deleted if the debit fails before any money moves) - see
  // createTopup/createBillPayment.
  status        MobileTransactionStatus @default(PENDING)
  reference     String                  @unique
  createdAt     DateTime                @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  service MobileService  @relation(fields: [serviceId], references: [id])
  forfait MobileForfait? @relation(fields: [forfaitId], references: [id])
}

// ---------- Payments (PayDunya) ----------

enum PaymentProvider {
  PAYDUNYA
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}

// What a payment is for. A plain string purposeId (not a typed FK) since
// one Payment can point at rows in any of several unrelated tables -
// ecommerce orders today, other modules as PayDunya gets wired into them.
enum PaymentPurpose {
  ECOMMERCE_ORDER
  RESTAURANT_ORDER
  MOBILE_TOPUP
  MOBILE_BILL
  INSURANCE_POLICY
  DELIVERY_REQUEST
  RIDE_REQUEST
  WALLET_TOPUP
  ANANDO_BOOKING
}

// ---------- Wallet ----------
// One wallet per user regardless of role - customers, vendors and delivery
// agents all use the same balance/top-up/history model. Funded by topping
// up through PayDunya (WALLET_TOPUP payment purpose above); spendable as a
// payment method wherever the app checks out (ecommerce first).

enum WalletTransactionType {
  TOPUP
  PAYMENT
  REFUND
  ADJUSTMENT
  EARNING
}

enum WalletTransactionDirection {
  CREDIT
  DEBIT
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("XOF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String                     @id @default(uuid())
  walletId     String
  type         WalletTransactionType
  direction    WalletTransactionDirection
  amount       Decimal                    @db.Decimal(12, 2)
  balanceAfter Decimal                    @db.Decimal(12, 2)
  // Freeform, mirroring Payment.purpose/purposeId - what this movement was
  // for (e.g. "ECOMMERCE_ORDER" + an order id, or "WALLET_TOPUP" + the
  // funding Payment's id). Nullable for plain admin adjustments.
  purpose      String?
  purposeId    String?
  description  String?
  createdAt    DateTime                   @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

model Payment {
  id            String          @id @default(uuid())
  userId        String
  provider      PaymentProvider @default(PAYDUNYA)
  providerToken String?         @unique
  checkoutUrl   String?
  status        PaymentStatus   @default(PENDING)
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("XOF")
  purpose       PaymentPurpose
  purposeId     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  order Order?

  @@index([purpose, purposeId])
}

// ---------- Anando (peer-to-peer carpooling) ----------
// Deliberately a separate module from Ride Sharing above, not an extension
// of it - the two are inverted shapes. Ride Sharing: a passenger requests a
// trip and any RIDER-role gig worker can accept it (1 request : 1 driver).
// Anando: a driver (any regular user, no special role) posts a trip
// they're already making with N seats, and any number of other users each
// claim one (1 posting : many bookings) - so the concurrency-guarded
// operation is a decrementing seat count, not a single-winner accept.

enum RidePostingStatus {
  OPEN
  FULL
  CANCELLED
  DEPARTED
}

model RidePosting {
  id                 String            @id @default(uuid())
  driverId           String
  originAddress      String
  originLat          Float?
  originLng          Float?
  destinationAddress String
  destinationLat     Float?
  destinationLng     Float?
  // For an instant posting (driver leaving right now, BlaBlaCar-style
  // "instant" availability rather than a scheduled trip) this is set to
  // the creation time rather than left null, so every posting still sorts
  // and displays the same way regardless of isInstant.
  departureAt        DateTime
  isInstant          Boolean           @default(false)
  seatsTotal         Int
  seatsAvailable     Int
  // Null = no in-app price - cost-sharing arranged off-platform (cash in
  // person). Non-null still allows CASH as the settlement method below;
  // it's just what the driver is asking passengers to pay.
  pricePerSeat       Decimal?          @db.Decimal(10, 2)
  note               String?
  status             RidePostingStatus @default(OPEN)
  createdAt          DateTime          @default(now())

  driver   User          @relation("RidePostingDriver", fields: [driverId], references: [id], onDelete: Cascade)
  bookings RideBooking[]

  @@index([status, departureAt])
}

enum RideBookingPaymentMethod {
  CASH
  WALLET
  PAYDUNYA
}

enum RideBookingStatus {
  CONFIRMED
  CANCELLED
}

model RideBooking {
  id            String                   @id @default(uuid())
  postingId     String
  passengerId   String
  seatsBooked   Int                      @default(1)
  paymentMethod RideBookingPaymentMethod
  // CASH settles off-platform, so `paid` just stays false as a record of
  // intent rather than a real payment; WALLET debits synchronously so
  // `paid` flips true immediately; PAYDUNYA starts false and flips true
  // once payments.service's IPN handler confirms the invoice, same as
  // ecommerce checkout.
  paid          Boolean                  @default(false)
  status        RideBookingStatus        @default(CONFIRMED)
  createdAt     DateTime                 @default(now())

  posting   RidePosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  passenger User        @relation("RideBookingPassenger", fields: [passengerId], references: [id], onDelete: Cascade)

  @@index([postingId])
  @@index([passengerId])
}

// ---------- Notifications ----------
// Generic, cross-module in-app notifications - Anando is the first
// consumer (new booking on your posting, posting full, posting
// cancelled), written so any other module can create one the same way.

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  // Freeform pointer to whatever this is about, mirroring
  // Payment.purpose/purposeId's loose-reference pattern above (e.g.
  // { postingId, bookingId }).
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ---------- Admin ----------
// Lets an ADMIN toggle each module on/off app-wide and, for the modules
// that have real fee math (delivery/rideshare), tune it without a code
// deploy. `key` matches the module boundaries used elsewhere in this repo
// (server/src/modules/<key>) - "mobile" covers both the airtime and
// bill-payment tiles on the web/mobile home screens, since they share one
// backend module and Prisma model (MobileService).
model ModuleConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  enabled   Boolean  @default(true)
  // Shape is module-specific and only actually read by delivery/rideshare
  // pricing today (see estimatePrice in each controller) - other modules
  // don't have configurable fee params yet, so this stays null for them.
  feeConfig Json?
  updatedAt DateTime @updatedAt
}

enum FeeValueType {
  PERCENT
  FLAT
}

// Per-service commission/fee + TVA (VAT) override, admin-configurable from
// the admin panel's "Fees & Tax" tab (see AdminServiceFeesTab.js). This is
// deliberately separate from ModuleConfig.feeConfig above: that JSON blob
// holds the existing agent/rider/vendor/owner *earner-share* splits (e.g.
// vendorSharePercent) computed off the original base price, and this table
// is an additive customer-facing surcharge (feeAmount/taxAmount) charged on
// top of that same base price - the two never touch the same number, so
// there's no risk of one silently changing the other's math.
//
// (moduleKey, serviceType, serviceId) is a loose polymorphic reference
// (same pattern as Payment.purpose/purposeId and
// WalletTransaction.purpose/purposeId below) rather than a foreign key,
// since serviceId points at a different table depending on serviceType -
// "MobileService"/"MobileForfait" rows in the mobile module, "Store" rows
// in ecommerce, "Restaurant" rows in the restaurant module. Only these
// three moduleKeys are wired to actually charge this today (see
// mobile.controller.js, ecommerce/orders.controller.js, restaurant/
// orders.controller.js) - see AdminServiceFeesTab.js for why the admin UI
// deliberately doesn't offer this for a module nothing reads it for yet.
model ServiceFeeConfig {
  id             String       @id @default(uuid())
  moduleKey      String
  serviceType    String
  serviceId      String
  // Denormalized display label (e.g. the store/service name at the time
  // this config was last saved), so the admin list doesn't need to re-join
  // every catalog table just to render - refreshed on every upsert.
  label          String
  feeEnabled     Boolean      @default(false)
  feeType        FeeValueType @default(PERCENT)
  feeValue       Decimal      @default(0) @db.Decimal(10, 2)
  taxEnabled     Boolean      @default(false)
  taxRatePercent Decimal      @default(0) @db.Decimal(5, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([moduleKey, serviceType, serviceId])
  @@index([moduleKey])
}

// Named service areas an admin draws on a map (see /admin/zones) - storage
// + CRUD only for now. Nothing in delivery/rideshare/ecommerce yet checks
// whether a request's coordinates fall inside a zone; point-in-polygon
// enforcement against these is the natural next step once zones exist to
// enforce against.
model ServiceZone {
  id            String   @id @default(uuid())
  name          String
  moduleKey     String
  // Array of {lat, lng} points closing an implicit polygon (first/last
  // point not repeated), drawn via the Google Maps JS Drawing library on
  // the admin zones page and stored as plain JSON rather than a PostGIS
  // geometry type - this app has no geospatial querying anywhere yet.
  boundary      Json
  feeMultiplier Float?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([moduleKey])
}

// Generic external-service credential/config store an admin fills in from
// /admin/providers - e.g. an SMS gateway. `category` is a free-text label
// (not an enum) so admins can add new kinds of provider without a schema
// migration; only category "SMS" has real behavior wired to it today (see
// server/src/utils/smsGateway.js, used by utils/otp.js when
// OTP_DEV_MODE=false). `config`'s shape for SMS describes a single HTTP
// request template with {phone}/{code}/{message} placeholders - see
// smsGateway.js for the exact fields it reads.
model Provider {
  id        String   @id @default(uuid())
  category  String
  name      String
  isActive  Boolean  @default(false)
  isDefault Boolean  @default(false)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])
}
