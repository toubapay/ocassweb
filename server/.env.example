DATABASE_URL="postgresql://ocass:ocass_dev_pw@127.0.0.1:5432/ocassweb"
PORT=5000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# OTP delivery. In dev mode OTP codes are logged to the server console and
# returned in the API response so the app is testable without an SMS account.
OTP_DEV_MODE=true
OTP_TTL_MINUTES=5
# Optional, dev mode only: makes every OTP this fixed 6-digit code instead
# of a fresh random one, so repeated manual testing (e.g. logging into the
# admin panel over and over) doesn't need copying a new code each time.
# Never honored unless OTP_DEV_MODE=true, so it's safe to leave set even
# if you sometimes flip OTP_DEV_MODE off locally.
# OTP_DEV_FIXED_CODE=000000

# PayDunya (www.paydunya.com) - Senegalese payment gateway used for checkout.
# Get these from your PayDunya dashboard > API keys. Use "test" mode until
# you've validated the integration against PayDunya's sandbox.
PAYDUNYA_MODE="test"
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""

# Used to build PayDunya's return/cancel/callback URLs. APP_BASE_URL must be
# publicly reachable so PayDunya's servers can reach the IPN callback_url -
# in local dev this only works if you tunnel it (e.g. ngrok).
APP_FRONTEND_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:5000"

# Optional: real road-distance pricing (Google Distance Matrix API) for
# delivery and ride-sharing, instead of straight-line Haversine distance -
# see server/src/utils/distanceMatrix.js. Falls back to Haversine on any
# failure (including this being unset), so it's safe to leave blank. This is
# a SERVER-SIDE key, deliberately separate from the frontend's
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (see root .env.production) - restrict it in
# Google Cloud Console by IP address, not HTTP referrer, and enable the
# Distance Matrix API for it.
GOOGLE_MAPS_SERVER_KEY=""

# A.A.S "Assurance Digitale" (Sénégal, branche AUTOMOBILE) - vehicle
# insurance comparison/issuance. Real credentials belong in admin >
# Providers (category INSURANCE_AAS), which wins over these env vars - see
# server/src/modules/insurance/aasClient.js. For local dev/testing without
# real AAS sandbox access, run `npm run aas:standin` and point these at it:
AAS_BASE_URL=""
AAS_PARTNER=""
AAS_USERNAME="token"
AAS_ACCESS_TOKEN=""
AAS_POLICE=""
AAS_TIMEOUT_MS=15000
# Tariff decision, not a technical default - see aasGuarantees.js.
AAS_GARANTIE_OPT_PT=""

# Optional: lets scripts/create-admin.js run with no CLI args (so the
# password never sits in this shell's command history) - set these in the
# environment, then run `node scripts/create-admin.js`. CLI args still win
# over these if both are given. Not read anywhere else in the app.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: powers POST /api/insurance/auto/carte-grise/scan - reads a
# photo of a carte grise (vehicle registration card) via Claude's vision
# API and prefills the auto insurance vehicle-info step. Safe to leave
# unset: the endpoint returns a 503 (OCR_NOT_CONFIGURED) and the frontend
# falls back to manual entry, same as a missing Maps key does elsewhere.
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=""
